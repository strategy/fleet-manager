# Doar pentru metoda B (LocalStack pornit cu docker compose).
# Copiați în .env.localstack, care NU se comite, și puneți token-ul vostru de pe
# https://app.localstack.cloud, pagina Auth Tokens
# Pentru MiniStack, AWS_EMULATOR_IMAGE se pune în .env, NU aici: docker compose o citește doar din .env.
LOCALSTACK_AUTH_TOKEN=ls-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DISABLE_CORS_CHECKS=1
