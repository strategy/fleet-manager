{
  "name": "fleet-api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "start": "node dist/server.js",
    "bundle": "esbuild src/lambda.ts src/worker-lambda.ts --bundle --platform=node --target=node22 --outdir=build --log-level=warning"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.1155.0",
    "express": "^5.1.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
